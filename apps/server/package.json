    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.8.2",
    "node-routeros": "^1.6.9",
    "pg-boss": "^12.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@supabill/config": "workspace:*",
    "@types/node": "^22.13.14",
    "tsdown": "^0.16.5",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
